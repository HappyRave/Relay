---
import "@fontsource-variable/archivo/wdth.css";
import { Image } from "astro:assets";
import editor from "../content/docs/images/editor.png";
import countdown from "../content/docs/images/countdown.png";
import saved from "../content/docs/images/saved.png";
import editorSteps from "../content/docs/images/editor-steps.png";
import findImage from "../content/docs/images/find-image-step.png";
import textStep from "../content/docs/images/text-step.png";
import dataFile from "../content/docs/images/data-file.png";
import triggers from "../content/docs/images/triggers-cards.png";
import playOptions from "../content/docs/images/play-options.png";
import activity from "../content/docs/images/activity.png";
import exported from "../content/docs/images/exported.png";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const guide = `${base}/guide/`;
const download = "https://github.com/HappyRave/Relay/releases/latest";
const github = "https://github.com/HappyRave/Relay";
const steps = [
  ["p", "Click", "File"],
  ["p", "Click", "Invoice number"],
  ["k", "Type", "“invoice_2026”"],
  ["k", "Keys", "Ctrl + S"],
  ["l", "Wait for", "Save turns blue"],
  ["p", "Click", "Save"],
];
const pageTitles: Record<string, string> = {
  "record/": "Record a macro",
  "edit-steps/": "Edit the steps",
  "wait/": "Make a macro wait",
  "text/": "Type text that changes",
  "run-automatically/": "Run a macro automatically",
  "play/": "Play, loop and change speed",
  "play/#see-where-a-macro-clicks": "See where a macro clicks",
  "what-ran/": "See what ran and what failed",
  "scripts/": "Run a macro without Relay",
};
const tour = [
  {
    glyph: "r", name: "Record", page: "record/", title: "Press a key and work as usual.",
    text: "Every click, drag, scroll and keystroke is kept with its timing. The player stays out of the way while you work.",
    items: ["Across all your monitors, at any display scaling", "Clicks can follow their window when it moves", "<kbd>Esc</kbd> stops; Relay's own windows are never recorded"],
    pics: [{ img: countdown, alt: "The player, about to record" }, { img: saved, alt: "The new macro, saved", narrow: true }],
  },
  {
    glyph: "p", name: "Edit", page: "edit-steps/", title: "Steps you can read, and change.",
    text: "A recording becomes <b>Click · Save</b>, <b>Keys · Ctrl + S</b>, <b>Type · “invoice_0924”</b>. Mouse moves fold into the click they lead to.",
    items: ["Select several steps and change them at once", "Trim the pauses, smooth or straighten a mouse path", "Find a step by its text; undo anything"],
    pics: [{ img: editorSteps, alt: "The steps list: clicks, a wait, keys and typing" }],
  },
  {
    glyph: "l", name: "Wait", page: "wait/", title: "Wait for the screen, not the clock.",
    text: "A slow app no longer breaks the macro. It waits until a pixel turns the right color, or until a button appears.",
    items: ["<b>Wait for pixel</b>: pick it with a loupe, set how long to wait", "<b>Find image</b>: snip a button, Relay finds it anywhere, from half to twice its size, and clicks it", "A timeout says which step and why"],
    pics: [{ img: findImage, alt: "A Find image step: the image, its match and how long to look", narrow: true }],
  },
  {
    glyph: "k", name: "Type", page: "text/", title: "Text that changes every run.",
    text: "Type <code>Invoice {date} #{n}</code> and Relay fills it in as it plays. Give it a spreadsheet, and it plays once per row.",
    items: ["<code>{date}</code> <code>{time}</code> <code>{clipboard}</code> <code>{n}</code>, and <code>{col:Name}</code> from a CSV file", "Types the same on any keyboard layout"],
    pics: [{ img: textStep, alt: "A Text step with placeholders" }, { img: dataFile, alt: "A macro's data file" }],
  },
  {
    glyph: "p", name: "Run on cue", page: "run-automatically/", title: "Six ways to start without you.",
    text: "A macro can run when you press its key, or when something happens on your PC.",
    items: ["<b>Hotkey</b>, from any app", "<b>Schedule</b>: Mon–Fri at 09:00; <b>Every…</b> 5 seconds to 24 hours", "<b>App starts</b>, a <b>pixel changes</b>, an <b>image appears</b>"],
    pics: [{ img: triggers, alt: "A hotkey and a schedule trigger", narrow: true }],
  },
  {
    glyph: "p", name: "Play", page: "play/", title: "Play it your way.",
    text: "Accurate to about a millisecond, or a little human on purpose.",
    items: ["0.5× to 4×, once, N times or forever", "Vary timing by a few milliseconds so it doesn't look robotic", "Pause, resume and stop from the player"],
    pics: [{ img: playOptions, alt: "Play options: repeat, speed, data file, vary timing", narrow: true }],
  },
  {
    glyph: "r", name: "Show targets", isNew: true, page: "play/#see-where-a-macro-clicks", title: "See where it clicks before it does.",
    text: "A red ring ripples where each click lands, drags draw their path, keys show by the cursor. Or see every target at once, numbered in order.",
    items: ["Marks let clicks through and never show in screenshots", "On the player, one key"],
    pics: [],
  },
  {
    glyph: "l", name: "Activity", page: "what-ran/", title: "Know what ran while you were away.",
    text: "Every run is kept, triggered or not: when, how long, and what stopped it. Problems are counted, and a timeout opens at its step.",
    items: [],
    pics: [{ img: activity, alt: "Activity: every run, its trigger, how it ended and how long it took" }],
  },
  {
    glyph: "k", name: "Share", page: "scripts/", title: "Take it anywhere.",
    text: "Macros are small <code>.rly</code> files: back them up, send them, keep them in Git.",
    items: ["<b>Standalone program</b>: an <code>.exe</code> that plays it on any PC, without Relay", "<b>AutoHotkey v2</b> script, one block per step", "JSON, for your own tools"],
    pics: [{ img: exported, alt: "An exported program, playing", narrow: true }],
  },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Relay: a macro recorder for Windows</title>
  <meta name="description" content="Record what you do on your PC, edit it as readable steps, and play it back on a key, a schedule, or when something appears on screen. Free and open source.">
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
</head>
<body>
  <div class="wrap">
    <nav>
      <a class="brand" href={`${base}/`}><span class="logo"><i></i></span>Relay</a>
      <a class="hide" href="#features">Features</a>
      <a class="hide" href={guide}>Guide</a>
      <a class="hide" href={github}>GitHub</a>
      <a class="dl small" href={download}>Download</a>
    </nav>

    <header class="hero">
      <div>
        <h1>Do it once.<br>Relay does it <em>again.</em></h1>
        <p class="lede">Record what you do on your PC. Edit it as readable steps. Play it back on a key, a schedule, or when something appears on screen.</p>
        <div class="ctas">
          <a class="dl" href={download}>Download for Windows</a>
          <a class="ghost" href={guide}>Read the guide</a>
        </div>
        <p class="meta">Free and open source · Windows 10 and 11 · Nothing leaves your PC</p>
      </div>

      <div class="stage" id="stage" role="img" aria-label="Relay recording a task: two clicks, typing, a shortcut and a wait become six steps.">
        <div class="player" aria-hidden="true">
          <span class="k rec"></span><span class="k stop"></span>
          <span class="lcd"><span class="tag">REC</span>Recording 1<span class="t" id="t">00:00</span></span>
        </div>
        <div class="app" aria-hidden="true">
          <div class="bar"><b id="m-file">File</b><b>Edit</b><b>View</b></div>
          <label>Invoice number</label>
          <div class="input" id="inp"></div>
          <label>Customer</label>
          <div class="input">Northwind Ltd.</div>
          <div class="save" id="save">Save</div>
        </div>
        <div class="steps" aria-hidden="true">
          <div class="caps"><span>Steps</span><span id="n">0</span></div>
          {steps.map(([kind, what, detail]) => (
            <div class={`row ${kind}`}><span class={`glyph ${kind}`}></span><b>{what}</b><span>· {detail}</span></div>
          ))}
        </div>
        <div class="cursor" id="cur" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M3 2l7 19 2.5-8L21 10z" fill="#fff" stroke="#141415" stroke-width="1.5" stroke-linejoin="round"/></svg></div>
        <div class="ripple" id="rip" aria-hidden="true"></div>
      </div>
    </header>
  </div>

  <section class="light">
    <div class="wrap">
      <h2>Every click becomes a step you can read.</h2>
      <p class="sub">No code. Relay turns a recording into steps like <b>Click · Save</b> and <b>Ctrl + S</b>. Rename them, add waits, trim the pauses, undo anything.</p>
      <div class="shot"><Image src={editor} alt="The Relay editor: a macro's steps, the inspector, and the view with the mouse path and the timeline" widths={[944, 1888]} sizes="(max-width: 1180px) 100vw, 1124px" /></div>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <h2>Everything Relay does, in nine stops.</h2>
      <p class="sub">From the first recording to a macro that runs by itself every morning.</p>
      {tour.map((c, i) => (
        <div class="ch">
          <div>
            <div class="n"><span class={`glyph ${c.glyph}`}></span>{i + 1} · {c.name}{c.isNew && <span class="new">New</span>}</div>
            <h3>{c.title}</h3>
            <p set:html={c.text} />
            {c.items.length > 0 && <ul>{c.items.map(item => <li set:html={item} />)}</ul>}
            <a class="more" href={`${guide}${c.page}`}>{pageTitles[c.page]} →</a>
          </div>
          <div class={`pic${c.pics.length > 1 && c.pics.every(p => !p.narrow) ? " two" : ""}`}>
            {c.pics.map(p => (
              <div class={`shot${p.narrow ? " narrow" : ""}`}><Image src={p.img} alt={p.alt} widths={[p.img.width]} /></div>
            ))}
            {c.pics.length === 0 && (
              <div class="desk" role="img" aria-label="Show targets: a form's clicks numbered and joined in order, the typed text in a caption">
                <svg viewBox="0 0 520 300" aria-hidden="true">
                  <rect class="w" x="30" y="34" width="240" height="196" rx="8"/>
                  <rect class="m" x="42" y="46" width="40" height="20" rx="4"/><text x="51" y="56">File</text>
                  <rect class="m" x="88" y="46" width="40" height="20" rx="4"/><text x="97" y="56">Edit</text>
                  <rect class="m" x="134" y="46" width="44" height="20" rx="4"/><text x="142" y="56">View</text>
                  <text class="lb" x="42" y="86">Invoice number</text><rect class="i" x="42" y="94" width="214" height="24" rx="5"/><text class="mono" x="50" y="106">invoice_2026</text>
                  <text class="lb" x="42" y="136">Customer</text><rect class="i" x="42" y="144" width="214" height="24" rx="5"/><text class="mono" x="50" y="156">Northwind Ltd.</text>
                  <rect x="42" y="184" width="58" height="26" rx="5" fill="#2b2b2b"/><text x="56" y="197" fill="#fff">Save</text>
                  <path d="M62 56 L150 106 L71 197" fill="none" stroke="#e0300f" stroke-width="2" stroke-dasharray="1 6" stroke-linecap="round"/>
                  <circle cx="62" cy="56" r="4.5" fill="#e0300f"/><circle cx="150" cy="106" r="4.5" fill="#e0300f"/><circle cx="71" cy="197" r="4.5" fill="#e0300f"/>
                  <circle class="ring" cx="71" cy="197" r="26"/>
                  <circle cx="50" cy="44" r="8.5" fill="#e0300f"/><text class="badge" x="50" y="44">1</text>
                  <circle cx="138" cy="94" r="8.5" fill="#e0300f"/><text class="badge" x="138" y="94">2</text>
                  <circle cx="59" cy="185" r="8.5" fill="#e0300f"/><text class="badge" x="59" y="185">4</text>
                  <rect x="160" y="116" width="124" height="20" rx="10" fill="#141415"/><text class="cap" x="222" y="126">3 · “invoice_2026”</text>
                  <rect x="130" y="266" width="260" height="20" rx="10" fill="rgba(20,20,21,.8)"/><text class="cap" x="260" y="276">Invoice · 4 steps · Esc or click to go back</text>
                </svg>
              </div>
            )}
          </div>
        </div>
      ))}
      <div class="grid">
        <div class="card"><span class="glyph k"></span><h3>Stops when you say</h3><p><kbd>Esc</kbd>, any key, or the kill switch. Nothing is ever left pressed.</p></div>
        <div class="card"><span class="glyph l"></span><h3>Private</h3><p>Relay never connects to the internet. Your macros stay on your PC.</p></div>
        <div class="card"><span class="glyph p"></span><h3>Yours to set</h3><p>Light or dark, text up to 200%, your own keys, sounds if you want them.</p></div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="band">
      <div>
        <h2>Your first macro takes a minute.</h2>
        <p>Download, press <kbd>Ctrl</kbd> <kbd>Shift</kbd> <kbd>F9</kbd>, do the task, press <kbd>Esc</kbd>.</p>
      </div>
      <a class="dl" href={download}>Download for Windows</a>
    </div>
    <footer>
      <a href={guide}>User guide</a>
      <a href={`${base}/guide/faq/`}>FAQ</a>
      <a href={`${github}/blob/main/CHANGELOG.md`}>Changelog</a>
      <a href={github}>GitHub</a>
      <span class="sp">MIT license · Made with Rust and Tauri</span>
    </footer>
  </div>

  <script>
    const stage = document.getElementById("stage")!, cur = document.getElementById("cur")!, rip = document.getElementById("rip")!;
    const rows = [...document.querySelectorAll<HTMLElement>(".row")];
    const n = document.getElementById("n")!, t = document.getElementById("t")!, inp = document.getElementById("inp")!;
    const file = document.getElementById("m-file")!, save = document.getElementById("save")!;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));
    const show = (i: number) => { rows[i].classList.add("on"); n.textContent = String(i + 1); };
    const at = (el: HTMLElement) => {
      const s = stage.getBoundingClientRect(), r = el.getBoundingClientRect();
      return [r.left - s.left + r.width / 2, r.top - s.top + r.height / 2];
    };
    async function click(el: HTMLElement, i: number) {
      const [x, y] = at(el);
      cur.style.transform = `translate(${x - 3}px, ${y - 2}px)`;
      await sleep(750);
      rip.style.left = `${x}px`;
      rip.style.top = `${y}px`;
      rip.classList.remove("go");
      void rip.offsetWidth;
      rip.classList.add("go");
      el.classList.add("hit");
      show(i);
      await sleep(350);
    }
    let started = Date.now();
    async function loop() {
      for (;;) {
        started = Date.now();
        rows.forEach(r => r.classList.remove("on"));
        file.classList.remove("hit");
        save.classList.remove("hit");
        inp.textContent = "";
        n.textContent = "0";
        cur.style.transform = `translate(${stage.clientWidth - 60}px, ${stage.clientHeight - 60}px)`;
        await sleep(900);
        await click(file, 0);
        file.classList.remove("hit");
        await click(inp, 1);
        for (const ch of "invoice_2026") {
          inp.textContent += ch;
          await sleep(70);
        }
        show(2);
        await sleep(500);
        show(3);
        await sleep(700);
        show(4);
        await sleep(900);
        save.classList.add("hit");
        await click(save, 5);
        await sleep(2600);
      }
    }
    if (still) {
      rows.forEach((_, i) => show(i));
      inp.textContent = "invoice_2026";
      cur.style.display = "none";
    } else {
      setInterval(() => { t.textContent = `00:${String(Math.floor((Date.now() - started) / 1000) % 60).padStart(2, "0")}`; }, 250);
      loop();
    }
  </script>
</body>
</html>

<style is:global>
  :root {
    --paper: #f4f3ef; --alu-100: #ecebe6; --alu-200: #e1e0da; --alu-700: #5c5a55; --ink: #141415; --lcd: #101011;
    --red: #e0300f; --blue: #2450e6; --blue-soft: #c9d5ff; --blue-line: #6f8fff; --yellow: #ffc21a; --green: #1db46a;
    --bg: var(--alu-100); --bg-2: var(--paper); --text: var(--ink); --text-2: var(--alu-700);
    --line: rgba(20, 20, 21, 0.12); --line-strong: rgba(20, 20, 21, 0.3);
    --band: var(--ink); --band-text: var(--paper);
    --wash-pointer: rgba(36, 80, 230, 0.14); --wash-keys: rgba(255, 194, 26, 0.3); --wash-logic: rgba(29, 180, 106, 0.16);
    --shadow-window: 0 0 0 1px rgba(20, 20, 21, 0.1), 0 22px 60px rgba(20, 20, 21, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.5);
    --shadow-key: 0 0 0 1px var(--line-strong), 0 2px 0 rgba(20, 20, 21, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    --font: "Archivo Variable", "Archivo", system-ui, sans-serif;
    --spring: cubic-bezier(0.34, 1.56, 0.64, 1); --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161618; --bg-2: #1c1c1e; --text: var(--paper); --text-2: #b3b1ab;
      --line: rgba(244, 243, 239, 0.1); --line-strong: rgba(244, 243, 239, 0.26);
      --band: #2a2a2c; --band-text: var(--paper);
      --shadow-window: 0 0 0 1px rgba(0, 0, 0, 0.5), 0 22px 60px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.06);
      --shadow-key: 0 0 0 1px var(--line-strong), 0 2px 0 rgba(0, 0, 0, 0.5);
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: var(--font); color: var(--text); background: var(--bg); line-height: 1.45; }
  a { color: inherit; }
  img { max-width: 100%; height: auto; display: block; }
  h1, h2, h3 { text-wrap: balance; }
  kbd { font: inherit; font-size: 0.82em; font-weight: 650; display: inline-block; min-width: 1.9em; text-align: center; padding: 0.12em 0.5em; border-radius: 6px; background: var(--paper); color: var(--ink); box-shadow: 0 0 0 1px rgba(20,20,21,.3), 0 2px 0 rgba(0,0,0,.4); }
  :focus-visible { outline: 2px solid var(--blue-line); outline-offset: 3px; border-radius: 4px; }

  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 28px; }
  nav { display: flex; align-items: center; gap: 22px; height: 68px; font-weight: 600; font-size: 15px; }
  nav .brand { display: flex; align-items: center; gap: 10px; font-size: 19px; font-weight: 800; font-stretch: 110%; text-decoration: none; margin-right: auto; }
  nav a:not(.brand):not(.dl) { text-decoration: none; color: var(--text-2); }
  nav a:not(.brand):not(.dl):hover { color: var(--text); }
  .logo { width: 28px; height: 28px; background: #201e1d; padding: 5px; flex: none; border-radius: 3px; }
  .logo i { display: grid; place-items: center; width: 100%; height: 100%; background: #f3f2f2; }
  .logo i::after { content: ""; width: 54%; height: 54%; background: #ec3013; }

  .dl { display: inline-flex; align-items: center; gap: 10px; padding: 0 22px; height: 48px; border-radius: 8px; background: var(--red); color: #fff; font-weight: 700; font-size: 16px; text-decoration: none; box-shadow: 0 2px 0 #9e2008, inset 0 1px 0 rgba(255,255,255,.25); transition: transform 90ms var(--ease), box-shadow 90ms var(--ease); }
  .dl:active { transform: translateY(2px); box-shadow: 0 0 0 #9e2008; }
  .dl.small { height: 38px; font-size: 14px; padding: 0 16px; }
  .ghost { display: inline-flex; align-items: center; padding: 0 18px; height: 48px; border-radius: 8px; background: var(--bg-2); color: var(--text); font-weight: 650; text-decoration: none; box-shadow: var(--shadow-key); }

  .hero { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; align-items: center; padding: 48px 0 80px; }
  h1 { font-size: 64px; line-height: 0.98; margin: 0 0 22px; font-weight: 820; font-stretch: 112%; letter-spacing: -0.02em; }
  h1 em { font-style: normal; color: var(--red); }
  .lede { font-size: 20px; color: var(--text-2); margin: 0 0 30px; max-width: 30ch; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .meta { margin-top: 16px; font-size: 13px; color: var(--text-2); }

  .stage { position: relative; height: 470px; border-radius: 20px; overflow: hidden; background: radial-gradient(120% 90% at 20% 0%, #3a5bd9 0%, #1d2c6b 45%, #121733 100%); box-shadow: var(--shadow-window); }
  .app { position: absolute; left: 28px; top: 96px; width: 280px; height: 300px; background: #fbfbf9; border-radius: 10px; box-shadow: 0 10px 40px rgba(0,0,0,.35); padding: 14px; font-size: 13px; color: var(--ink); }
  .app .bar { display: flex; gap: 6px; margin-bottom: 14px; }
  .app .bar b { padding: 4px 10px; border-radius: 5px; background: #eceae4; font-weight: 600; transition: background 200ms; }
  .app .bar b.hit { background: var(--blue-soft); }
  .app label { display: block; font-size: 11px; color: #777; margin: 10px 0 4px; }
  .app .input { height: 30px; border: 1px solid #d8d6cf; border-radius: 6px; padding: 6px 8px; font-family: ui-monospace, monospace; }
  .app .save { margin-top: 18px; display: inline-block; padding: 7px 16px; border-radius: 6px; background: #2b2b2b; color: #fff; font-weight: 600; transition: background 200ms; }
  .app .save.hit { background: var(--blue); }
  .player { position: absolute; left: 50%; transform: translateX(-50%); top: 18px; width: 420px; max-width: calc(100% - 24px); height: 46px; border-radius: 12px; display: flex; align-items: center; gap: 6px; padding: 5px; background: rgba(244,243,239,.82); backdrop-filter: blur(18px); box-shadow: 0 8px 30px rgba(0,0,0,.3); }
  .player .k { width: 36px; height: 36px; flex: none; border-radius: 8px; display: grid; place-items: center; background: var(--paper); box-shadow: 0 0 0 1px rgba(20,20,21,.3), 0 2px 0 rgba(20,20,21,.18); }
  .player .k.rec { background: var(--red); }
  .player .k.rec::after { content: ""; width: 12px; height: 12px; border-radius: 50%; background: #fff; }
  .player .k.stop::after { content: ""; width: 10px; height: 10px; background: var(--ink); }
  .lcd { flex: 1; min-width: 0; height: 36px; border-radius: 8px; background: var(--lcd); color: var(--paper); display: flex; align-items: center; gap: 8px; padding: 0 10px; font-size: 12px; font-weight: 700; white-space: nowrap; }
